diff --git a/tools/mtmd/mtmd-image.cpp b/tools/mtmd/mtmd-image.cpp
index c36ba98..49a2591 100644
--- a/tools/mtmd/mtmd-image.cpp
+++ b/tools/mtmd/mtmd-image.cpp
@@ -179,6 +179,15 @@ struct img_tool {
             const auto beta = std::sqrt(static_cast<float>(min_pixels) / (height * width));
             h_bar = ceil_by_factor(height * beta);
             w_bar = ceil_by_factor(width * beta);
+            // when min_pixels ~= max_pixels (pinned budgets) the ceil can overshoot
+            // max_pixels, silently exceeding the requested token budget (measured:
+            // nemotron pinned 3328 delivered 3388, gemma4 pinned 1120 delivered
+            // 1170 pre-004). The budget is a hard ceiling -- fall back to flooring
+            // just under min_pixels instead.
+            if (h_bar * w_bar > max_pixels) {
+                h_bar = std::max(align_size, floor_by_factor(height * beta));
+                w_bar = std::max(align_size, floor_by_factor(width  * beta));
+            }
         }
 
         return {w_bar, h_bar};
