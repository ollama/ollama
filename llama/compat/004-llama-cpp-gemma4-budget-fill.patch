+    // Gemma 4 reference sizing (get_aspect_ratio_preserving_size in transformers'
+    // image_processing_gemma4.py): scale the image -- up or down -- by
+    // sqrt(budget_px / source_px) so the grid fills the budget, then floor each
+    // axis to align_size. The requested budget (max_pixels / align_size^2) is
+    // snapped DOWN to the supported ladder; requests below the lowest rung clamp
+    // up to it. The resulting grid always satisfies
+    //     cols*rows <= budget < (cols+1)*(rows+1)
+    // i.e. it is a grid the model saw in training. Note this makes
+    // --image-min-tokens a no-op for archs that opt in via image_budget_fill.
+    static clip_image_size calc_size_budget_fill(const clip_image_size & inp_size, const int align_size, const int max_pixels) {
+        GGML_ASSERT(align_size > 0);
+        if (inp_size.width <= 0 || inp_size.height <= 0) {
+            return {align_size, align_size};
+        }
+        static const int ladder[] = {70, 140, 280, 560, 1120};
+        const int px_per_token = align_size * align_size;
+        int budget = ladder[0];
+        for (int rung : ladder) {
+            if (rung * px_per_token <= max_pixels) {
+                budget = rung;
+            }
+        }
+        const double factor = std::sqrt(static_cast<double>(budget) * px_per_token
+                                        / (static_cast<double>(inp_size.width) * inp_size.height));
+        auto floor_by_factor = [f = align_size](double x) { return static_cast<int>(std::floor(x / f)) * f; };
+        int w_bar = std::max(align_size, floor_by_factor(inp_size.width  * factor));
+        int h_bar = std::max(align_size, floor_by_factor(inp_size.height * factor));
+        // extreme aspect ratios: the align_size clamp on the short axis can push
+        // the grid over budget; shave the long axis until it fits again
+        while ((w_bar / align_size) * (h_bar / align_size) > budget) {
+            if (w_bar >= h_bar) {
+                w_bar -= align_size;
+            } else {
+                h_bar -= align_size;
+            }
+        }
+        return {w_bar, h_bar};
+    }
+
