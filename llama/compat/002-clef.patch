+common_decision_type common_get_decision_type(const llama_model * model) {
+    char value[128];
+    if (llama_model_meta_val_str(model, "general.architecture", value, sizeof(value)) < 0) {
+        return COMMON_DECISION_TYPE_NONE;
+    }
+    const std::string key = std::string(value) + ".decision.type";
+    if (llama_model_meta_val_str(model, key.c_str(), value, sizeof(value)) < 0) {
+        return COMMON_DECISION_TYPE_NONE;
+    }
+    return std::strcmp(value, "clef") == 0 ? COMMON_DECISION_TYPE_CLEF : COMMON_DECISION_TYPE_UNKNOWN;
+}
