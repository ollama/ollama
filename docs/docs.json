      "family": "system-ui"
    }
  },
  "styling": {
    "codeblocks": "system"
  },
  "contextual": {
    "options": [
      "copy"
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Sign in",
        "href": "https://ollama.com/signin"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Download",
      "href": "https://ollama.com/download"
    }
