{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Ollama",
  "colors": {
    "primary": "#000",
    "light": "#b5b5b5",
    "dark": "#000"
  },
  "favicon": "/images/favicon.png",
  "logo": {
    "light": "/images/logo.png",
    "dark": "/images/logo-dark.png",
    "href": "https://ollama.com"
  },
  "theme": "maple",
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#000000"
