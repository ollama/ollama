<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package
      Name="Ollama MLX Dependencies"
      Manufacturer="Ollama, Inc."
      Version="$(DEPS_VERSION)"
      Scope="perUser"
      UpgradeCode="4F8B2C6D-0E3A-5B7F-C9D1-2E3F4A5B6C7D"
      InstallerVersion="500">

      <MajorUpgrade AllowDowngrades="yes" Schedule="afterInstallInitialize" />
      <Property Id="ARPSYSTEMCOMPONENT" Value="1" />
      <MediaTemplate EmbedCab="yes" MaximumUncompressedMediaSize="$(CABSIZEMB)" CompressionLevel="high" />

      <!-- Component group is dynamically generated by generate-backend-deps.ps1 -->
      <ComponentGroupRef Id="mlx_cuda_v13_deps_Components" />

      <Feature Id="MainFeature" Title="Ollama MLX Dependencies" Level="1">
        <ComponentGroupRef Id="mlx_cuda_v13_deps_Components" />
      </Feature>
    </Package>
</Wix>
