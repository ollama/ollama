 #include "mlx/backend/no_gpu/linux_memory.h"
+#elif defined(_WIN32)
+#include <windows.h>
+size_t get_memory_size() {
+  MEMORYSTATUSEX status;
+  status.dwLength = sizeof(status);
+  if (GlobalMemoryStatusEx(&status)) {
+    return (size_t)status.ullTotalPhys;
+  }
+  return 0;
+}
 #else
 size_t get_memory_size() {
   return 0;
